+++ b/imam_datasub_backend/prisma/migrations/20260804090000_add_support_tickets/migration.sql
@@ -0,0 +1,38 @@
+-- Support ticket system. The Flutter app already has a full "My Tickets" /
+-- "New ticket" UI (support_screen.dart) calling POST /support/tickets and
+-- GET /support/tickets/mine, but no backend table for it existed at all -
+-- every call was a 404. This creates what it needs.
+
+CREATE TYPE "TicketStatus" AS ENUM ('OPEN', 'PENDING', 'CLOSED');
+CREATE TYPE "TicketSender" AS ENUM ('USER', 'ADMIN');
+
+CREATE TABLE IF NOT EXISTS "SupportTicket" (
+    "id" TEXT NOT NULL,
+    "userId" TEXT NOT NULL,
+    "subject" TEXT NOT NULL,
+    "status" "TicketStatus" NOT NULL DEFAULT 'OPEN',
+    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updatedAt" TIMESTAMP(3) NOT NULL,
+
+    CONSTRAINT "SupportTicket_pkey" PRIMARY KEY ("id")
+);
+
+CREATE TABLE IF NOT EXISTS "SupportTicketMessage" (
+    "id" TEXT NOT NULL,
+    "ticketId" TEXT NOT NULL,
+    "senderType" "TicketSender" NOT NULL,
+    "senderId" TEXT NOT NULL,
+    "senderName" TEXT NOT NULL,
+    "message" TEXT NOT NULL,
+    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+
+    CONSTRAINT "SupportTicketMessage_pkey" PRIMARY KEY ("id")
+);
+
+CREATE INDEX IF NOT EXISTS "SupportTicket_userId_idx" ON "SupportTicket"("userId");
+CREATE INDEX IF NOT EXISTS "SupportTicket_status_idx" ON "SupportTicket"("status");
+CREATE INDEX IF NOT EXISTS "SupportTicketMessage_ticketId_idx" ON "SupportTicketMessage"("ticketId");
+
+ALTER TABLE "SupportTicketMessage"
+  ADD CONSTRAINT "SupportTicketMessage_ticketId_fkey"
+  FOREIGN KEY ("ticketId") REFERENCES "SupportTicket"("id") ON DELETE CASCADE ON UPDATE CASCADE;
diff --git a/imam_datasub_backend/prisma/schema.prisma b/imam_datasub_backend/prisma/schema.prisma
index 775f026..1e48683 100644
--- a/imam_datasub_backend/prisma/schema.prisma
+++ b/imam_datasub_backend/prisma/schema.prisma
@@ -190,6 +190,44 @@ model ServicePricing {
 
   @@index([isActive])
 }
+enum TicketStatus {
+  OPEN
+  PENDING
+  CLOSED
+}
+
+enum TicketSender {
+  USER
+  ADMIN
+}
+
+model SupportTicket {
+  id        String              @id @default(uuid())
+  userId    String
+  subject   String
+  status    TicketStatus        @default(OPEN)
+  createdAt DateTime            @default(now())
+  updatedAt DateTime            @updatedAt
+  messages  SupportTicketMessage[]
+
+  @@index([userId])
+  @@index([status])
+}
+
+model SupportTicketMessage {
+  id         String        @id @default(uuid())
+  ticketId   String
+  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
+  senderType TicketSender
+  // senderId is the User.id or AdminUser.id depending on senderType - not a
+  // Prisma relation since it points at two different tables.
+  senderId   String
+  senderName String
+  message    String
+  createdAt  DateTime      @default(now())
+
+  @@index([ticketId])
+}
