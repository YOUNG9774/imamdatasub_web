NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://postgres:Kindness%409774%40@localhost:5432/imam_datasub
DIRECT_URL=postgresql://postgres:Kindness%409774%40@localhost:5432/imam_datasub
AUTH_TOKEN_SECRET=dev-only-insecure-auth-token-secret-change-me
