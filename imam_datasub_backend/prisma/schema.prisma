generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Used for normal app queries at runtime - goes through Supabase's
  // PgBouncer transaction pooler (port 6543), which scales much better
  // under load from the running server.
  url       = env("DATABASE_URL")
  // Used ONLY by `prisma migrate deploy` / `prisma db push`. Migrations run
  // DDL statements and take an advisory lock, neither of which PgBouncer's
  // transaction-pooling mode supports - so migrations must go through a
  // direct, non-pooled connection (Supabase port 5432) or they hang forever.
  directUrl = env("DIRECT_URL")
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum TransactionType {
  WALLET_FUNDING
  WALLET_TRANSFER
  DATA_PURCHASE
  AIRTIME_PURCHASE
  ELECTRICITY_PURCHASE
  CABLE_PURCHASE
  RESULT_PIN
  SMS
  WITHDRAWAL
  REFERRAL_COMMISSION
  MANUAL_ADJUSTMENT
  COUPON_REDEMPTION
}

enum AdminRole {
  SUPER_ADMIN
  FINANCE
  SUPPORT
}

model User {
  id                   String         @id
  fullName             String
  email                String         @unique
  phone                String         @unique
  passwordHash         String?
  photoUrl             String?
  walletBalanceKobo    BigInt         @default(0)
  referralCode         String         @unique
  referredByCode       String?
  referralEarningsKobo BigInt         @default(0)
  kycStatus            KycStatus      @default(UNVERIFIED)
  emailVerified        Boolean        @default(false)
  phoneVerified        Boolean        @default(false)
  pinHash              String?
  pinFailures          Int            @default(0)
  pinLockedUntil       DateTime?
  virtualAccountNumber String?
  virtualAccountBank   String?
  paystackCustomerCode String?
  bvnLast4             String?
  bvnVerifiedAt        DateTime?
  kycFailureReason     String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  transactions         Transaction[]
  refreshTokens        RefreshToken[]
  redeemedCoupons      Coupon[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Transaction {
  id                String            @id
  userId            String
  type              TransactionType
  status            TransactionStatus @default(PENDING)
  amountKobo        BigInt
  balanceBeforeKobo BigInt
  balanceAfterKobo  BigInt
  provider          String?
  providerRef       String?
  reference         String            @unique
  idempotencyKey    String?
  description       String
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@unique([userId, idempotencyKey])
}

model DataPlanPricing {
  id               String   @id @default(uuid())
  provider         String   @default("alrahuz")
  providerPlanId   String
  network          String
  networkId        Int
  planType         String?
  name             String
  validity         String?
  providerCostKobo BigInt
  sellingPriceKobo BigInt?
  isActive         Boolean  @default(true)
  lastSeenAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([provider, providerPlanId])
  @@index([network, isActive])
  @@index([networkId, isActive])
}

/// Prepaid funding codes ("Fund with Coupon" in the app) — generated by an admin
/// (see CouponResource in AdminJS), sold/shared out-of-band (e.g. via WhatsApp),
/// and redeemed once by a user to credit their wallet.
model Coupon {
  id               String    @id @default(uuid())
  code             String    @unique
  valueKobo        BigInt
  isRedeemed       Boolean   @default(false)
  redeemedByUserId String?
  redeemedAt       DateTime?
  createdByAdminId String?
  note             String?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  redeemedBy       User?     @relation(fields: [redeemedByUserId], references: [id])

  @@index([isRedeemed])
}

/// Tracks the reseller's own balance AT Alrahuz (the upstream VTU provider) —
/// a completely separate ledger from any customer's in-app wallet. Alrahuz
/// requires this to be pre-funded before it will fulfill any purchase; if it
/// runs dry, purchases fail regardless of the customer's own balance. Updated
/// opportunistically from the `balance_after` field Alrahuz returns on every
/// purchase response — this is a read-only mirror of Alrahuz's own number,
/// not a balance this app manages.
model ProviderBalanceStatus {
  provider              String    @id
  lastKnownBalance      Float
  lastCheckedAt         DateTime  @updatedAt
  lowBalanceAlertSentAt DateTime?
}

model AdminUser {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  fullName     String
  role         AdminRole       @default(SUPPORT)
  isActive     Boolean         @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  auditLogs    AdminAuditLog[]
}

model AdminAuditLog {
  id         String    @id @default(uuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}
